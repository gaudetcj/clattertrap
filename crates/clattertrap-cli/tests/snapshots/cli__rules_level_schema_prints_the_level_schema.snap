            "y_cm",
            "length_cm"
          ],
          "type": "object"
        },
        {
          "description": "Fixed pad that launches whatever lands on it.",
          "properties": {
            "angle_deg": {
              "default": 0.0,
              "description": "Tilt of the pad; the launch is along its up normal.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "spring_pad",
              "type": "string"
            },
            "x_cm": {
              "description": "Centre x.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
