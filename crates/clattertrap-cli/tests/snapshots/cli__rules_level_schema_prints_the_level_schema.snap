              "const": "bell",
              "type": "string"
            },
            "rope_cm": {
              "description": "Rope length up to the bracket.",
              "format": "float",
              "type": "number"
            },
            "x_cm": {
              "description": "Bell centre x.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "Bell centre y.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm",
            "rope_cm"
          ],
          "type": "object"
        },
