            "y_cm"
          ],
          "type": "object"
        },
        {
          "description": "Wooden box.",
          "properties": {
            "kind": {
              "const": "crate",
              "type": "string"
            },
            "side_cm": {
              "description": "Side length.",
              "format": "float",
