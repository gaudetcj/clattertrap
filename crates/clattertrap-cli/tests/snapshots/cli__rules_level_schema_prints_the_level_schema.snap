          "description": "Goal object: fixed open-top container to fill.",
          "properties": {
            "inner_height_cm": {
              "description": "Inner height.",
              "format": "float",
              "type": "number"
            },
            "inner_width_cm": {
              "description": "Inner width.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "basket",
              "type": "string"
            },
