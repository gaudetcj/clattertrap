        },
        "pendulum": {
          "default": 0,
          "description": "Pendulums.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "pin": {
          "default": 0,
          "description": "Pins.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "rope": {
          "default": 0,
          "description": "Ropes.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "seesaw": {
          "default": 0,
          "description": "Seesaws.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "spring_pad": {
          "default": 0,
          "description": "Spring pads.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Material": {
      "description": "Ball materials.",
      "oneOf": [
        {
          "const": "steel",
          "description": "Heavy, barely bounces.",
          "type": "string"
        },
        {
          "const": "wood",
          "description": "Medium weight and bounce.",
          "type": "string"
        },
        {
          "const": "rubber",
          "description": "Light, bounces high.",
          "type": "string"
        }
      ]
    },
    "Placed": {
      "description": "One part with its id. The `kind` tag and the part's fields sit beside `id` in JSON.",
      "oneOf": [
        {
          "description": "Fixed wooden plank.",
          "properties": {
            "angle_deg": {
              "description": "Tilt; negative slopes down to the right.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "beam",
              "type": "string"
            },
            "length_cm": {
              "description": "Length along the plank.",
              "format": "float",
              "type": "number"
            },
            "x_cm": {
              "description": "Centre x.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "Centre y.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm",
            "length_cm",
            "angle_deg"
          ],
          "type": "object"
        },
        {
          "description": "Fixed pair of inward-sloping walls.",
          "properties": {
            "height_cm": {
              "description": "Height from throat to mouth.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "funnel",
              "type": "string"
            },
            "mouth_cm": {
              "description": "Width of the top opening.",
              "format": "float",
              "type": "number"
            },
            "throat_cm": {
              "description": "Width of the bottom opening.",
              "format": "float",
              "type": "number"
            },
            "x_cm": {
              "description": "Centre x of the throat.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "y of the throat opening.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm",
            "mouth_cm",
            "throat_cm",
            "height_cm"
          ],
          "type": "object"
        },
        {
          "description": "Rolling ball of a material.",
          "properties": {
            "kind": {
              "const": "ball",
              "type": "string"
            },
            "material": {
              "$ref": "#/$defs/Material",
