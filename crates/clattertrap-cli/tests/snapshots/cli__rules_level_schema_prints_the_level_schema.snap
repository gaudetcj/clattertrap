---
source: crates/clattertrap-cli/tests/cli.rs
expression: out
---
{
  "$defs": {
    "Goal": {
      "description": "The level's goal. `target` names a fixed object; `via` lists parts that must be touched first, in order.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Ring the bell named by `target`.",
          "properties": {
            "kind": {
              "const": "ring",
              "type": "string"
            },
            "target": {
              "description": "Bell id.",
              "type": "string"
            },
            "via": {
              "default": [],
              "description": "Waypoint part ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Press the button named by `target`.",
          "properties": {
            "kind": {
              "const": "press",
              "type": "string"
            },
            "target": {
              "description": "Button id.",
              "type": "string"
            },
            "via": {
              "default": [],
              "description": "Waypoint part ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rest `count` objects inside the basket named by `target`.",
          "properties": {
            "count": {
              "description": "Objects required at rest inside.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "fill",
              "type": "string"
            },
            "target": {
              "description": "Basket id.",
              "type": "string"
            },
            "via": {
              "default": [],
              "description": "Waypoint part ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "target",
            "count"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pop the balloon named by `target`.",
          "properties": {
            "kind": {
              "const": "pop",
              "type": "string"
            },
            "target": {
              "description": "Balloon id.",
              "type": "string"
            },
            "via": {
              "default": [],
              "description": "Waypoint part ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        }
      ]
    },
    "Inventory": {
      "additionalProperties": false,
      "description": "Parts a contestant may place, by kind. Missing kinds are zero.",
      "properties": {
        "ball": {
          "default": 0,
          "description": "Balls of any material.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "balloon": {
          "default": 0,
          "description": "Balloons.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "beam": {
          "default": 0,
          "description": "Beams.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
