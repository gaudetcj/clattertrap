            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm",
            "side_cm"
          ],
          "type": "object"
        },
        {
          "description": "Plank pivoting freely about its fixed centre.",
          "properties": {
            "angle_deg": {
              "default": 0.0,
              "description": "Starting tilt.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "seesaw",
              "type": "string"
