            "inner_width_cm",
            "inner_height_cm"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "description": "Unique id within the level and scene.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "WorldSize": {
      "additionalProperties": false,
      "description": "World rectangle in centimetres, origin bottom-left.",
      "properties": {
        "height_cm": {
          "description": "Height.",
          "format": "float",
          "type": "number"
        },
        "width_cm": {
          "description": "Width.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "width_cm",
        "height_cm"
      ],
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "description": "A build zone rectangle in centimetres, by its bottom-left corner.",
      "properties": {
        "height_cm": {
          "description": "Height.",
          "format": "float",
          "type": "number"
        },
        "width_cm": {
          "description": "Width.",
          "format": "float",
          "type": "number"
        },
        "x_cm": {
          "description": "Left edge.",
          "format": "float",
          "type": "number"
        },
        "y_cm": {
          "description": "Bottom edge.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x_cm",
        "y_cm",
        "width_cm",
        "height_cm"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One level.",
  "properties": {
    "description": {
      "description": "The layout in prose for contestants: where things are and what they do at the start.",
      "type": "string"
    },
    "fixed": {
      "description": "Objects placed by the level, including goal objects.",
      "items": {
        "$ref": "#/$defs/Placed"
      },
      "type": "array"
    },
    "goal": {
      "$ref": "#/$defs/Goal",
      "description": "What counts as success."
    },
    "id": {
      "description": "Stable id, also the directory name.",
      "type": "string"
    },
    "inventory": {
      "$ref": "#/$defs/Inventory",
      "description": "How many of each part kind a contestant may use."
    },
    "rules_version": {
      "description": "Rules version the level was authored for.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "showcase": {
      "default": false,
      "description": "Whether chain length is scored too.",
      "type": "boolean"
    },
    "tier": {
      "description": "Difficulty from 1 (one part) to 5 (several mechanisms in a chain).",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "time_limit_s": {
      "description": "Run length cap.",
      "format": "float",
      "type": "number"
    },
    "title": {
      "description": "Short title shown to viewers.",
      "type": "string"
    },
    "world": {
      "$ref": "#/$defs/WorldSize",
      "description": "Size of the world rectangle; the floor is its bottom edge."
    },
    "zones": {
      "description": "Rectangles where a contestant may place part centres.",
      "items": {
        "$ref": "#/$defs/Zone"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "tier",
    "description",
    "rules_version",
    "world",
    "time_limit_s",
    "fixed",
    "zones",
    "inventory",
    "goal"
  ],
  "title": "Level",
  "type": "object"
}
