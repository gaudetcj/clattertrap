        },
        {
          "description": "Steel weight hanging from a fixed pin on a rigid rope.",
          "properties": {
            "angle_deg": {
              "default": 0.0,
              "description": "Starting angle from straight down, counterclockwise positive.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "pendulum",
              "type": "string"
            },
            "length_cm": {
              "description": "Rope length.",
