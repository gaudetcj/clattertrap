            "y_cm",
            "width_cm",
            "height_cm"
          ],
          "type": "object"
        },
        {
          "description": "Rises until it meets a pin.",
          "properties": {
            "kind": {
              "const": "balloon",
              "type": "string"
            },
            "x_cm": {
              "description": "Centre x.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "Centre y.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm"
          ],
          "type": "object"
        },
        {
          "description": "Fixed needle that pops balloons.",
          "properties": {
            "angle_deg": {
              "default": -90.0,
              "description": "Direction the point faces; the default points down.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "pin",
              "type": "string"
            },
            "x_cm": {
              "description": "Base x.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "Base y.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm"
          ],
          "type": "object"
        },
        {
          "description": "Links two parts so they stay within a maximum distance.",
          "properties": {
            "a": {
              "description": "Id of the first linked part.",
              "type": "string"
            },
            "b": {
              "description": "Id of the second linked part.",
              "type": "string"
            },
            "kind": {
              "const": "rope",
              "type": "string"
            },
            "max_length_cm": {
              "description": "Longest the rope can stretch.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "a",
            "b",
            "max_length_cm"
          ],
          "type": "object"
        },
