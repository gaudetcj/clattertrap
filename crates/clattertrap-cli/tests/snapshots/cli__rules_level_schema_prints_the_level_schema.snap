              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "Centre y.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x_cm",
            "y_cm",
            "material"
          ],
          "type": "object"
        },
        {
          "description": "Standing tile that tips when pushed.",
          "properties": {
            "angle_deg": {
              "default": 0.0,
              "description": "Tilt from upright.",
              "format": "float",
              "type": "number"
            },
            "kind": {
              "const": "domino",
              "type": "string"
            },
            "x_cm": {
              "description": "Centre x.",
              "format": "float",
              "type": "number"
            },
            "y_cm": {
              "description": "Centre y.",
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
